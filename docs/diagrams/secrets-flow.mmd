flowchart TD
    subgraph sources ["Where keys come from"]
        direction LR
        env["Environment variables<br/>CI and cloud secret stores"] -->|"take precedence"| lookup{"Secret lookup<br/>by name only"}
        file[("~/.config/verdy/secrets.env<br/>chmod 600, outside every repo")] --> lookup
        config["Run config"] -->|"secret names"| lookup
        config -.->|"holds a key-shaped value"| reject["Rejected before<br/>anything runs"]
        lookup --> secret["Secret object<br/>prints as name, source,<br/>fingerprint"]
    end
    subgraph uses ["Where they go"]
        direction LR
        claude["Claude client<br/>ANTHROPIC_API_KEY"] --> redact["Redactor<br/>removes loaded keys and<br/>key-shaped strings"]
        scenesmith["SceneSmith subprocess<br/>only the keys listed for it"] --> redact
        redact --> out["Logs, errors,<br/>stored output"]
        sign["Report signing<br/>VERDY_SIGNING_KEY"]
        fp["Fingerprint<br/>sha256, hmac or none"] --> report[("Evidence report<br/>fingerprints, never keys")]
    end
    sources -->|"the value reaches only<br/>the client that needs it"| uses
    scan["verdy secrets scan"] -.->|"exit 1 on a committed key"| ci{"CI"}
