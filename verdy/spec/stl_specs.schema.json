{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dti.ai/verdy/spec/stl-specs/0.2.0",
  "title": "Verdy STL safety specs",
  "description": "A set of Signal Temporal Logic requirements that every rollout is scored against.",
  "type": "object",
  "required": ["specs"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "formula"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "description": {"type": "string"},
          "formula": {"type": "string", "minLength": 1},
          "signals": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          },
          "severity": {"enum": ["critical", "major", "minor"]},
          "monitor": {
            "description": "Past-time formula used by the on-robot runtime monitor.",
            "type": "string"
          }
        }
      }
    }
  }
}
