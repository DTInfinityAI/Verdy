{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dti.ai/verdy/spec/odd/0.3.0",
  "title": "Verdy ODD",
  "description": "Operational Design Domain: the conditions a robot policy is expected to operate in.",
  "type": "object",
  "required": ["name", "version", "parameters"],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "description": "Version of this meta-schema the document targets.",
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/parameter"}
    },
    "constraints": {
      "description": "Boolean expressions over parameter names that every scenario must satisfy.",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["name", "category", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "description": {"type": "string"},
        "category": {"enum": ["environment", "platform", "task", "sensors", "faults"]},
        "type": {"enum": ["continuous", "categorical", "boolean", "temporal"]},
        "unit": {"type": "string"},
        "range": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        },
        "values": {"type": "array", "minItems": 1},
        "weights": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "distribution": {"type": "string"},
        "default": {},
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {"type": "string"},
            "sim": {"type": "string"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {"enum": ["llm", "human", "log", "ontology"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "approved": {"type": "boolean"},
            "note": {"type": "string"},
            "new_ontology_entry": {
              "description": "Not in the ontology when drafted: a proposed new entry.",
              "type": "boolean"
            },
            "also_mentioned_as": {"type": "array", "items": {"type": "string"}},
            "resolution": {"$ref": "#/$defs/resolution"}
          }
        }
      }
    },
    "resolution": {
      "description": "How authoring resolved the description's wording to this parameter.",
      "type": "object",
      "required": ["resolver", "decision"],
      "properties": {
        "resolver": {"description": "exact, laya, llm, or a plug-in.", "type": "string"},
        "model": {"type": "string"},
        "decision": {"description": "Ontology entry chosen, or none.", "type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate": {"description": "Name the extraction step proposed.", "type": "string"},
        "phrase": {"description": "Words in the description that mention it.", "type": "string"},
        "proposed": {"description": "Resolver's choice when it was rejected.", "type": "string"},
        "reason": {"type": "string"},
        "ontology": {"description": "Ontology name@version.", "type": "string"},
        "embedder": {"type": "string"},
        "shortlist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entry", "score"],
            "properties": {"entry": {"type": "string"}, "score": {"type": "number"}}
          }
        }
      }
    }
  }
}
