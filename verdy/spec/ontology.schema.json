{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dti.ai/verdy/spec/ontology/0.2.0",
  "title": "Verdy parameter ontology",
  "description": "A versioned tree of canonical ODD parameters. Nodes with a type are leaves (parameters); other nodes are groups. Roots are ODD categories.",
  "type": "object",
  "required": ["name", "version", "nodes"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "max_children": {
      "description": "Most children any node may have (default 15), leaving room for 'none' in Laya's option budget.",
      "type": "integer",
      "minimum": 2
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "parent": {"type": "string"},
        "label": {"type": "string"},
        "definition": {"description": "One line.", "type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["draft", "approved"]},
        "type": {"enum": ["continuous", "categorical", "boolean", "temporal"]},
        "unit": {"type": "string"},
        "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "values": {"type": "array", "minItems": 1},
        "distribution": {"type": "string"},
        "grounding": {
          "description": "Where the parameter lives: sim (simulator parameter), runtime (on-robot signal).",
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    }
  }
}
