{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dti.ai/verdy/spec/ontology/0.1.0",
  "title": "Verdy parameter ontology",
  "description": "Canonical ODD parameter definitions that ODD authoring resolves descriptions to.",
  "type": "object",
  "required": ["name", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "category", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "description": {"type": "string"},
        "category": {"enum": ["environment", "platform", "task", "sensors", "faults"]},
        "type": {"enum": ["continuous", "categorical", "boolean", "temporal"]},
        "unit": {"type": "string"},
        "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "values": {"type": "array", "minItems": 1},
        "distribution": {"type": "string"},
        "synonyms": {"type": "array", "items": {"type": "string"}},
        "grounding": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
